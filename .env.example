# Copy to `.env` in the project and fill in. NEVER commit the real .env.
# Document every required variable here so reviewers/teammates know what to set.

# Anthropic API key (server-side only — never expose to the browser)
ANTHROPIC_API_KEY=sk-ant-...

# Secret used to sign session cookies. Use a long random string (e.g. `openssl rand -hex 32`).
# On Render this is generated automatically (see render.yaml).
SESSION_SECRET=change-me-to-a-long-random-string

# Postgres connection string. Locally you can run `docker compose up -d` and use the line below;
# on Render this is provided automatically from the managed database (see render.yaml).
DATABASE_URL=postgres://anchor:anchor@localhost:5432/anchor

# Optional: port (hosts usually inject PORT automatically)
# PORT=3001
